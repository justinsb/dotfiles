#!/bin/bash

set -e
set -x

ln -sf $(pwd)/bash_aliases ~/.bash_aliases
ln -sf $(pwd)/bashrc ~/.bashrc
ln -sf $(pwd)/bash_profile ~/.bash_profile
ln -sf $(pwd)/profile ~/.profile
ln -sf $(pwd)/gitconfig ~/.gitconfig
ln -sf $(pwd)/zshrc ~/.zshrc

mkdir -p ${BIN}/
export PATH=~/bin:$PATH

ARCH=$(uname -m)
OS=$(uname -s)

if [[ "${OS}" == "Linux" ]]; then
  OS=linux
elif [[ "${OS}" == "Darwin" ]]; then
  OS=darwin
fi

if [[ "${ARCH}" == "x86_64" ]]; then
  ARCH=amd64
fi

BIN=~/.local/bin
mkdir -p ${BIN}

APPS=~/.local/apps
mkdir -p ${APPS}

download_file() {
  # Usage: download_file <url> <output_file>
  local url="$1"
  local output="$2"
  curl -L --fail "$url" -o "$output"
}

tasks/install-go

tasks/install-gh

tasks/install-kustomize

tasks/install-terraform

tasks/install-helm

tasks/install-crane

tasks/install-kind

tasks/install-kops

tasks/install-kubectl

tasks/install-stern

tasks/install-awscli

tasks/install-yq

# Only on stock debian
if grep 'BUG_REPORT_URL.*debian' /etc/os-release; then
  mkdir -p ~/.config/systemd/user
  cp systemd/*.service ~/.config/systemd/user/

  systemctl --user enable ssh-agent
  systemctl --user start ssh-agent
fi


tasks/install-node
tasks/install-gemini-cli


tasks/install-srctool

tasks/install-gcloud

tasks/install-ripgrep
tasks/install-git-absorb